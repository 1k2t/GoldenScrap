; audio_converter.pio
.program audio_rj_rx
; Inputs: 
; - DATA_IN (0),
; - LRCLK (1), 
; - SCK (2)
; JMP:
; - LRCLK
.wrap_target
    ; 残り 95 bit を読み捨て（初回はずれるが大した問題じゃない）
    ; エッジ #1 ~ #95 (エッジ #0 は既に過ぎてる)
    mov x, y
data_wait_L:
    wait 0 pin 2
    wait 1 pin 2
    jmp x--, data_wait_L
bit_loop_L:
    wait 0 pin 2
    wait 1 pin 2
    jmp pin, rx_read_bit_L
    jmp rx_Rch
rx_read_bit_L:
    in pins, 1
    jmp bit_loop_L
    ; R-ch
    ; ここに来た時点で既に 1 bit 過ぎてる
rx_Rch:
    push
    mov x, y        ; 残り 95 bit を読み捨て
data_wait_R:
    wait 0 pin 2
    wait 1 pin 2
    jmp x--, data_wait_R
rx_bit_loop_R:
    wait 0 pin 2
    wait 1 pin 2
    jmp pin, rx_bit_loop_R_end
    in pins, 1
    jmp rx_bit_loop_R
rx_bit_loop_R_end:
    push
    irq 0 rel
.wrap

% c-sdk {
static inline void audio_rj_rx_program_init(PIO pio, uint sm, uint offset, uint pin) {
    const uint input_pin_count = 3;

    pio_sm_config c = audio_rj_rx_program_get_default_config(offset);
    
    sm_config_set_in_pins(&c, pin);
    sm_config_set_jmp_pin(&c, pin + 1);
        
    for(int i = 0; i < input_pin_count; i++){
        pio_gpio_init(pio, pin);
    }

    /* true:出力 false:入力 */
    pio_sm_set_consecutive_pindirs(pio, sm, pin, 3, false);

    /* false = Shift left, autopull, after DATA_BITS */
    sm_config_set_in_shift(&c, false, false, 32);

    /* プログラムをロードさせ、プログラムの実行位置を先頭(offsetの位置)に移動します。 */
    pio_sm_init(pio, sm, offset, &c);

    /* 初期設定 */
    pio_sm_set_enabled(pio, sm, false);
    pio_sm_put_blocking(pio, sm, (128 - 32) - 2); /* wait states */
    pio_sm_exec(pio, sm, pio_encode_pull(false, false));
    pio_sm_exec(pio, sm, pio_encode_out(pio_y, 32));
    pio_sm_exec(pio, sm, pio_encode_jmp(offset));
    pio_sm_set_enabled(pio, sm, false);
}
%}

