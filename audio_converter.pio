.program audio_lj_tx
; Outputs: 
; - DATA_OUT (0)
; - LRCLK (1 side set), 
;
; Inputs:
; - SCK (2)
.side_set 1 opt         ; LRCLK is controlled by side-set
.wrap_target
    pull
tx_data_L:
    wait 1 pin 0
    wait 0 pin 0
    out pins, 1       side 0b0
    jmp !osre, tx_data_L
    pull
tx_data_R:
    wait 1 pin 0
    wait 0 pin 0
    out pins, 1       side 0b1
    jmp !osre, tx_data_R
;tx_start:
;    set y, 1
;tx_loop_ch:
;    pull
;    set x, 7
;tx_wait:
;    wait 1 pin 0
;    wait 0 pin 0
;    out null, 1
;    jmp x--, tx_wait
;tx_data:
;    wait 1 pin 0
;    wait 0 pin 0
;    jmp !y, tx_R
;tx_L:
;    out pins, 1       side 0b1
;    jmp tx_next_bit
;tx_R:
;    out pins, 1       side 0b0
;tx_next_bit:
;    jmp !osre, tx_data
;    jmp y--, tx_loop_ch 
.wrap
 
% c-sdk {
static inline void audio_lj_tx_program_init(PIO pio, uint sm, uint offset, uint pin_data, uint pin_lrck, uint pin_sck_in) {

    pio_sm_config c = audio_lj_tx_program_get_default_config(offset);
    
    sm_config_set_in_pins(&c, pin_sck_in);
    sm_config_set_in_pin_count(&c, 1);
    sm_config_set_out_pins(&c, pin_data, 1);
    sm_config_set_out_pin_count(&c, 1);
    sm_config_set_sideset_pins(&c, pin_lrck);

    pio_gpio_init(pio, pin_sck_in);
    pio_gpio_init(pio, pin_data);
    pio_gpio_init(pio, pin_lrck);

    // 対象のGPIOを出力に設定します。(true:出力 false:入力)
    pio_sm_set_consecutive_pindirs(pio, sm, pin_sck_in, 1, false);
    pio_sm_set_consecutive_pindirs(pio, sm, pin_data, 1, true);
    pio_sm_set_consecutive_pindirs(pio, sm, pin_lrck, 1, true);

    /* false = Shift left, autopull, after DATA_BITS */
    sm_config_set_out_shift(&c, false, false, 32);

    // プログラムをロードさせ、プログラムの実行位置を先頭(offsetの位置)に移動します。
    pio_sm_init(pio, sm, offset, &c);
    
    // ステートマシンを走らせます。 (true:開始 false:停止)
    pio_sm_set_enabled(pio, sm, false);
}
%}